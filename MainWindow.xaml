<Window x:Class="SmartOrganizer.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartOrganizer v0.26.0">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyboardAcceleratorPlacementMode="Hidden">
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked"/><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked"/><KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Location_Invoked"/></Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Padding="16,10,16,8" ColumnSpacing="8"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="36"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="SmartOrganizer" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentFolder}" Margin="16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
   <Button Grid.Column="2" Width="40" Height="36" ToolTipService.ToolTip="更新 (F5)" Click="Refresh_Click"><SymbolIcon Symbol="Refresh"/></Button>
   <Button Grid.Column="3" Width="40" Height="36" ToolTipService.ToolTip="その他"><FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="場所を変更" KeyboardAcceleratorTextOverride="Ctrl+L" Click="ChangeFolder_Click"/><ToggleMenuFlyoutItem Text="サブフォルダーを含める" Click="IncludeSubfolders_Click"/><MenuFlyoutItem Text="コピー内容を確認" Click="PreviewCopy_Click"/><MenuFlyoutItem Text="移動内容を確認" Click="PreviewMove_Click"/><MenuFlyoutItem Text="直前の操作をUndo" Click="Undo_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="履歴" Click="History_Click"/><MenuFlyoutItem Text="設定" Click="Settings_Click"/><MenuFlyoutSeparator/><MenuFlyoutSubItem Text="整理条件"><MenuFlyoutItem Text="最近追加の日数" Click="RecentDays_Click"/><MenuFlyoutItem Text="大きいファイルのしきい値" Click="LargeThreshold_Click"/></MenuFlyoutSubItem><MenuFlyoutSubItem Text="外観"><MenuFlyoutRadioItem Text="システム設定に合わせる" GroupName="theme" Click="SystemTheme_Click"/><MenuFlyoutRadioItem Text="ライト" GroupName="theme" Click="LightTheme_Click"/><MenuFlyoutRadioItem Text="ダーク" GroupName="theme" Click="DarkTheme_Click"/><MenuFlyoutSeparator/><MenuFlyoutRadioItem Text="標準密度" GroupName="density" Click="StandardDensity_Click"/><MenuFlyoutRadioItem Text="Compact" GroupName="density" Click="CompactDensity_Click"/></MenuFlyoutSubItem><MenuFlyoutItem Text="列幅をリセット" Click="ResetColumns_Click"/></MenuFlyout></Button.Flyout></Button>
   <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Grid.ColumnSpan="2" QueryIcon="Find" PlaceholderText="ファイルを検索" MinWidth="280" AutomationProperties.Name="ファイルを検索" TextChanged="SearchBox_TextChanged"/>
   <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="SubfolderFilter" PlaceholderText="サブフォルダー" MinWidth="150" ItemsSource="{x:Bind ViewModel.Subfolders}" SelectionChanged="SubfolderFilter_SelectionChanged"/><ComboBox x:Name="KindFilter" PlaceholderText="種類" MinWidth="112" ItemsSource="{x:Bind ViewModel.Kinds}" SelectionChanged="KindFilter_SelectionChanged"/><ComboBox x:Name="SourceFilter" PlaceholderText="取得元" MinWidth="128" ItemsSource="{x:Bind ViewModel.Sources}" SelectionChanged="SourceFilter_SelectionChanged"/><ComboBox x:Name="ExtensionFilter" PlaceholderText="拡張子" MinWidth="112" ItemsSource="{x:Bind ViewModel.Extensions}" SelectionChanged="ExtensionFilter_SelectionChanged"/><ComboBox x:Name="SortFilter" MinWidth="120" SelectedIndex="0" SelectionChanged="SortFilter_SelectionChanged"><x:String>新しい順</x:String><x:String>古い順</x:String><x:String>名前 A-Z</x:String><x:String>名前 Z-A</x:String><x:String>サイズ 大</x:String><x:String>サイズ 小</x:String></ComboBox></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="適用中:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ActiveFiltersText" Text="{x:Bind ViewModel.ActiveFiltersText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="760"/><Button Content="すべて解除" Click="ClearFilters_Click" Padding="10,2"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Padding="16,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="クイックアクセス" Margin="8,4" Style="{ThemeResource CaptionTextBlockStyle}"/><ListView x:Name="QuickAccessList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.QuickAccess}" IsItemClickEnabled="True" ItemClick="QuickAccessList_ItemClick" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Grid Height="34" Padding="8,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe Fluent Icons"/><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Expander Grid.Row="2" Header="カテゴリー" IsExpanded="True"><ListView x:Name="CategoryList" ItemsSource="{x:Bind ViewModel.Categories}" SelectionMode="Single" TabIndex="1" IsItemClickEnabled="True" ItemClick="CategoryList_ItemClick"><ListView.ItemTemplate><DataTemplate><Grid Height="36" Padding="8,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe Fluent Icons"/><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
   </Expander></Grid><Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <ScrollViewer x:Name="TableScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" IsTabStop="True">
     <Grid x:Name="TableExtent" Width="1050" MinWidth="1050" Margin="0,0,16,16"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="HeaderGrid" Background="{ThemeResource LayerFillColorAltBrush}" Padding="12,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NameColumn" Width="420"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="KindColumn" Width="130"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="SourceColumn" Width="190"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="ModifiedColumn" Width="170"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="SizeColumn" Width="100"/></Grid.ColumnDefinitions>
       <TextBlock Text="名前" VerticalAlignment="Center"/><Thumb Grid.Column="1" DragDelta="ColumnSplitter_DragDelta" Tag="0"/><TextBlock Grid.Column="2" Text="種類" VerticalAlignment="Center"/><Thumb Grid.Column="3" DragDelta="ColumnSplitter_DragDelta" Tag="1"/><TextBlock Grid.Column="4" Text="作成・取得元" VerticalAlignment="Center"/><Thumb Grid.Column="5" DragDelta="ColumnSplitter_DragDelta" Tag="2"/><TextBlock Grid.Column="6" Text="更新日時" VerticalAlignment="Center"/><Thumb Grid.Column="7" DragDelta="ColumnSplitter_DragDelta" Tag="3"/><TextBlock Grid.Column="8" Text="サイズ" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" TabIndex="2" DoubleTapped="FileList_DoubleTapped"><ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="開く" Click="ContextOpen_Click"/><MenuFlyoutItem Text="元の場所を開く" Click="ContextOpenFolder_Click"/><MenuFlyoutItem Text="パスをコピー" Click="ContextCopyPath_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="コピー内容を確認" Click="PreviewCopy_Click"/><MenuFlyoutItem Text="移動内容を確認" Click="PreviewMove_Click"/><MenuFlyoutItem Text="詳細" Click="Details_Click"/></MenuFlyout></ListView.ContextFlyout><ListView.ItemTemplate><DataTemplate><Grid Height="36" Padding="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="4"/><ColumnDefinition Width="130"/><ColumnDefinition Width="4"/><ColumnDefinition Width="190"/><ColumnDefinition Width="4"/><ColumnDefinition Width="170"/><ColumnDefinition Width="4"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DuplicateGroup}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding Modified}" VerticalAlignment="Center"/><TextBlock Grid.Column="8" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
     </Grid>
    </ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="8" Background="{ThemeResource LayerFillColorAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OperationStatus" Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center"/><Button x:Name="CancelOperationButton" Grid.Column="1" Content="キャンセル" Click="CancelOperation_Click" IsEnabled="False" Visibility="Collapsed"/><Button Grid.Column="2" Content="次の200件" Click="LoadMore_Click" IsEnabled="{x:Bind ViewModel.HasMore, Mode=OneWay}"/><TextBlock Grid.Column="3" Text="{x:Bind ViewModel.VisibleCount, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
 </Grid>
</Window>
